{
  "name": "hess-flipper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "node --import tsx scripts/generate-data.ts",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "validate": "node --import tsx scripts/generate-data.ts --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
